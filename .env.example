# Set these in Render's Environment panel. Never commit real values.
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DATABASE?sslmode=require
CLOUDINARY_URL=cloudinary://API_KEY:API_SECRET@CLOUD_NAME
SECRET_KEY=GENERATE_A_LONG_RANDOM_SECRET
FACE_ENCRYPTION_KEY=GENERATE_A_FERNET_KEY
ADMIN_USERNAME=admin
ADMIN_PASSWORD=SET_A_UNIQUE_PASSWORD_AT_LEAST_12_CHARACTERS
TZ_NAME=Asia/Kolkata
FACE_THRESHOLD=0.48
# Defaults: secure cookies, PostgreSQL required, production mode.
# Local development ONLY: APP_ENV=development and DATABASE_URL=sqlite:///local.db
